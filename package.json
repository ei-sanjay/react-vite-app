{
  "name": "react-vite-vitest-cypress",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,md,json}\" \"tests/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.{json,md,cjs,mjs,ts,js}\" \".storybook/**/*.{js,cjs,mjs,ts,tsx}\" \"cypress/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css,scss,md,json}\" \"tests/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.{json,md,cjs,mjs,ts,js}\" \".storybook/**/*.{js,cjs,mjs,ts,tsx}\" \"cypress/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,md,json}\" \"tests/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.{json,md,cjs,mjs,ts,js}\" \".storybook/**/*.{js,cjs,mjs,ts,tsx}\" \"cypress/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "start-server-and-test \"npx vite --host 127.0.0.1 --port 5173 --strictPort\" http://127.0.0.1:5173 \"cypress run\"",
    "test:e2e:install": "cypress install",
    "cypress:open": "start-server-and-test \"npx vite --host 127.0.0.1 --port 5173 --strictPort\" http://127.0.0.1:5173 \"cypress open\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "@reduxjs/toolkit": "^2.6.1",
    "react-redux": "^9.2.0",
    "styled-components": "^6.1.15",
    "@mui/material": "^6.4.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@sentry/react": "^9.5.0"
  },
  "devDependencies": {
    "vite": "^6.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/styled-components": "^5.1.34",
    "vitest": "^3.0.8",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.0.0",
    "cypress": "^14.2.0",
    "start-server-and-test": "^2.0.11",
    "storybook": "^8.6.4",
    "@storybook/react": "^8.6.4",
    "@storybook/addon-essentials": "^8.6.4",
    "@storybook/react-vite": "^8.6.4",
    "@storybook/test": "^8.6.4",
    "eslint": "^9.22.0",
    "@eslint/js": "^9.22.0",
    "globals": "^16.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "cypress"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  }
}
